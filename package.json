{
  "name": "thumbfast-cli",
  "version": "0.1.0",
  "description": "CLI for Thumbfa.st - AI thumbnail generation, persons, inspirations, images, and credits",
  "type": "module",
  "bin": {
    "thumbfast-cli": "./dist/index.js"
  },
